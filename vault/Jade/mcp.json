{
  "mcpServers": {
    "pandora": {
      "command": "node",
      "args": [
        "${PANDORA_MCP_DIR}/pandora-mcp-server.cjs"
      ],
      "env": {
        "FAE_STORAGE_BASE": "${VAULT_DIR}"
      },
      "cwd": "${PANDORA_MCP_DIR}",
      "exposure": "direct",
      "enabled": true,
      "description": "Local Pandora MCP bridge: GitHub, Fae-library vault, and Tavily web search."
    }
  },
  "autoEnableCodemode": true
}
